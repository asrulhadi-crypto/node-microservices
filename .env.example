# API Gateway
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
NODE_ENV=development

# User Service
USER_SERVICE_PORT=3001
USER_SERVICE_HOST=0.0.0.0
USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_NAME=microservices_user
USER_DB_USER=postgres
USER_DB_PASSWORD=postgres
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Product Service
PRODUCT_SERVICE_PORT=3002
PRODUCT_SERVICE_HOST=0.0.0.0
PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5432
PRODUCT_DB_NAME=microservices_product
PRODUCT_DB_USER=postgres
PRODUCT_DB_PASSWORD=postgres

# Order Service
ORDER_SERVICE_PORT=3003
ORDER_SERVICE_HOST=0.0.0.0
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5432
ORDER_DB_NAME=microservices_order
ORDER_DB_USER=postgres
ORDER_DB_PASSWORD=postgres

# Message Broker (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Monitoring
PROMETHEUS_ENABLED=true
JAEGER_ENABLED=true
JAEGER_HOST=localhost
JAEGER_PORT=6831
